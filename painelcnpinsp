-- // SISTEMA DE DRAG
local function makeDraggable(guiObject)
	local dragging = false
	local dragInput, mousePos, framePos
	guiObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			mousePos = input.Position
			framePos = guiObject.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	guiObject.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - mousePos
			guiObject.Position = UDim2.new(
				framePos.X.Scale,
				framePos.X.Offset + delta.X,
				framePos.Y.Scale,
				framePos.Y.Offset + delta.Y
			)
		end
	end)
end
-- // ANIMAÇÃO DE ABRIR/FECHAR
local function toggleMenu(mainFrame, mainScale)
	if menuState.isTweening then return end
	menuState.isTweening = true
	if not menuState.isOpen then
		mainFrame.Visible = true
		menuState.isOpen = true
		local sizeTween = TweenService:Create(mainFrame, CONFIG.Tween.Info, {Size = CONFIG.Sizes.MenuOpen})
		local scaleTween = TweenService:Create(mainScale, CONFIG.Tween.Info, {Scale = 1})
		sizeTween:Play()
		scaleTween:Play()
		sizeTween.Completed:Wait()
	else
		menuState.isOpen = false
		local sizeTween = TweenService:Create(mainFrame, CONFIG.Tween.Info, {Size = CONFIG.Sizes.MenuClosed})
		local scaleTween = TweenService:Create(mainScale, CONFIG.Tween.Info, {Scale = 0.85})
		sizeTween:Play()
		scaleTween:Play()
		sizeTween.Completed:Wait()
		mainFrame.Visible = false
	end
	menuState.isTweening = false
end
